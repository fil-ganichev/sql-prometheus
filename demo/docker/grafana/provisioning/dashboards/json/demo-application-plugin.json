    {
      "id": 9,
      "type": "table",
      "title": "SQL · Медленные действия с ошибками",
      "description": "Действия, у которых были ошибки: 95-й перцентиль и скорость ошибок. Окно берётся из выбранного диапазона дашборда. Строки без ошибок не показываются.",
      "datasource": {
        "type": "sqlprometheus-datasource",
        "uid": "sql-prometheus-plugin"
      },
      "gridPos": {
        "h": 15,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "95й перцентиль"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "операция",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "sqlprometheus-datasource",
            "uid": "sql-prometheus-plugin"
          },
          "sql": "SELECT lat.process_action AS \"операция\",\n       PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY lat.le) AS \"95й перцентиль\",\n       AVG(PROM_IRATE(err.\"value\", '5m')) AS rps\nFROM operation_time_seconds_bucket lat\nJOIN operation_code_total err\n  ON lat.process_action = err.process_action\nWHERE err.code = 'ERROR'\n  AND $__timeFilter(lat.\"timestamp\")\nGROUP BY lat.process_action"
        }
      ],
      "transformations": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SQL · Чтение и запись — RPS",
      "description": "get* и search* — чтение, остальные process_action — запись. irate считается в Prometheus, сумма по типу — в SQL, отдельно на каждую точку времени.",
      "datasource": {
        "type": "sqlprometheus-datasource",
        "uid": "sql-prometheus-plugin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "transformations": [],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "sqlprometheus-datasource",
            "uid": "sql-prometheus-plugin"
          },
          "sql": "SELECT \"timestamp\",\n       CASE WHEN process_action LIKE 'get%' OR process_action LIKE 'search%' THEN 'Read' ELSE 'Write' END AS op_type,\n       SUM(PROM_IRATE(\"value\", '5m')) AS \"value\"\nFROM operation_code_total\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY \"timestamp\",\n         CASE WHEN process_action LIKE 'get%' OR process_action LIKE 'search%' THEN 'Read' ELSE 'Write' END"
        }
      ]
    },
