          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "transformations": [],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "sqlprometheus-datasource",
            "uid": "sql-prometheus-plugin"
          },
          "sql": "SELECT \"timestamp\", code, PROM_SUM(PROM_RATE(\"value\", '1m')) AS \"value\"\nFROM operation_code_total\nWHERE $__timeFilter(\"timestamp\")"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SQL · operation_time — среднее время",
      "description": "rate суммы делён на rate счётчика, окно 1 минута. Ряд называется действием.",
      "datasource": {
        "type": "sqlprometheus-datasource",
        "uid": "sql-prometheus-plugin"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "transformations": [],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "sqlprometheus-datasource",
            "uid": "sql-prometheus-plugin"
          },
          "sql": "SELECT s.\"timestamp\" AS \"timestamp\", s.process_action, s.\"value\" / c.\"value\" AS \"value\"\nFROM (\n  SELECT \"timestamp\", process_action, PROM_SUM(PROM_RATE(\"value\", '1m')) AS \"value\"\n  FROM operation_time_seconds_sum\n  WHERE $__timeFilter(\"timestamp\")\n) s\nJOIN (\n  SELECT \"timestamp\", process_action, PROM_SUM(PROM_RATE(\"value\", '1m')) AS \"value\"\n  FROM operation_time_seconds_count\n  WHERE $__timeFilter(\"timestamp\")\n) c\nON s.\"timestamp\" = c.\"timestamp\" AND s.process_action = c.process_action"
        }
      ]
    },
    {
