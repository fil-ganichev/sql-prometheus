  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "SQL · operation_code — RPS (SUCCESS / ERROR)",
      "description": "PROM_SUM(PROM_RATE) по operation_code_total. Ряд называется кодом результата.",
      "datasource": {
        "type": "sqlprometheus-datasource",
        "uid": "sql-prometheus-plugin"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
