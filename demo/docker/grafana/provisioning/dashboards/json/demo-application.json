      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "sql-prometheus"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "root_selector": "",
          "url": "http://grafana-connector:8081/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\":\"SELECT \\\"timestamp\\\", code, PROM_SUM(PROM_RATE(\\\"value\\\", '1m')) AS \\\"value\\\" FROM operation_code_total WHERE \\\"timestamp\\\" >= TIMESTAMP '${__timeFrom:date:YYYY-MM-DD HH:mm:ss}' AND \\\"timestamp\\\" < TIMESTAMP '${__timeTo:date:YYYY-MM-DD HH:mm:ss}'\"}"
          },
          "columns": [
