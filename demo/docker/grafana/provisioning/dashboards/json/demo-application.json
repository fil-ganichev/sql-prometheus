      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
"sortBy": [
            {
              "displayName": "операция",
              "desc": false
            }
          ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "sql-prometheus"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "root_selector": "",
          "url": "http://grafana-connector:8081/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\": \"SELECT lat.process_action AS process_action, PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY lat.le) AS p95_seconds, AVG(PROM_IRATE(err.value, '5m')) AS error_rate FROM operation_time_seconds_bucket lat JOIN operation_code_total err ON lat.process_action = err.process_action WHERE err.code = 'ERROR' AND lat.\\\"timestamp\\\" > TIMESTAMP '${__timeTo:date:YYYY-MM-DD HH:mm:ss}' - (INTERVAL '${__timeTo:date:seconds}' SECOND - INTERVAL '${__timeFrom:date:seconds}' SECOND) AND lat.\\\"timestamp\\\" >= TIMESTAMP '${__timeFrom:date:YYYY-MM-DD HH:mm:ss}' AND lat.\\\"timestamp\\\" <= TIMESTAMP '${__timeTo:date:YYYY-MM-DD HH:mm:ss}' GROUP BY lat.process_action\"}"
          },
          "columns": [
            {
              "selector": "process_action",
              "text": "операция",
              "type": "string"
            },
            {
              "selector": "p95_seconds",
              "text": "95й перцентиль",
              "type": "number"
            },
            {
              "selector": "error_rate",
              "text": "rps",
              "type": "number"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "операция": 0,
              "95й перцентиль": 1,
              "rps": 2
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "SQL · Чтение и запись — RPS",
      "description": "get* и search* — чтение, остальные process_action — запись. irate считается в Prometheus, сумма по типу — в SQL, отдельно на каждую точку времени.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "sql-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "op_type"
            ],
            "keepFields": false
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^value (.*)$",
            "renamePattern": "$1"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "sql-prometheus"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "root_selector": "",
          "url": "http://grafana-connector:8081/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\":\"SELECT \\\"timestamp\\\", CASE WHEN process_action LIKE 'get%' OR process_action LIKE 'search%' THEN 'Read' ELSE 'Write' END AS op_type, SUM(PROM_IRATE(\\\"value\\\", '5m')) AS \\\"value\\\" FROM operation_code_total WHERE \\\"timestamp\\\" >= TIMESTAMP '${__timeFrom:date:YYYY-MM-DD HH:mm:ss}' AND \\\"timestamp\\\" < TIMESTAMP '${__timeTo:date:YYYY-MM-DD HH:mm:ss}' GROUP BY \\\"timestamp\\\", CASE WHEN process_action LIKE 'get%' OR process_action LIKE 'search%' THEN 'Read' ELSE 'Write' END\"}"
          },
          "columns": [
            {
              "selector": "timestamp",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            },
            {
              "selector": "op_type",
              "text": "op_type",
              "type": "string"
            }
          ]
        }
      ]
    },
